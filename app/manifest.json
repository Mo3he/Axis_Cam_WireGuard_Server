{
  "schemaVersion": "2.0.0",
  "acapPackageConf": {
    "setup": {
      "appName": "WireGuard_Server",
      "friendlyName": "WireGuard Server",
      "vendor": "moshe@mohome.net",
      "vendorId": "70ee172dd9",
      "vendorUrl": "https://github.com/Mo3he/Axis_Cam_WireGuard_Server",
      "version": "0.1.0",
      "architecture": "BUILDARCH",
      "runMode": "respawn",
      "compatibleOsVersions": [
        {
          "min": "11.11",
          "max": "13"
        }
      ]
    },
    "configuration": {
      "settingPage": "index.html",
      "reverseProxy": [
        {
          "apiPath": "api",
          "target": "http://localhost:2211/",
          "access": "admin"
        },
        {
          "apiPath": "status",
          "target": "http://localhost:2212/",
          "access": "admin"
        }
      ],
      "paramConfig": [
        {
          "name": "Enabled",
          "default": "no",
          "type": "bool:no,yes"
        },
        {
          "name": "PrivateKey",
          "default": "",
          "type": "password"
        },
        {
          "name": "ListenPort",
          "default": "51820",
          "type": "string"
        },
        {
          "name": "Address",
          "default": "10.66.0.1/24",
          "type": "string"
        },
        {
          "name": "Peers",
          "default": "",
          "type": "string"
        },
        {
          "name": "RouteSubnets",
          "default": "",
          "type": "string"
        },
        {
          "name": "PeerToPeer",
          "default": "no",
          "type": "bool:no,yes"
        },
        {
          "name": "MTU",
          "default": "1420",
          "type": "string"
        },
        {
          "name": "PublicEndpoint",
          "default": "",
          "type": "string"
        },
        {
          "name": "ClientDNS",
          "default": "",
          "type": "string"
        }
      ]
    }
  }
}
